{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "fixture-dist",
    "design",
    "node_modules",
    "empty-dist",
    ".astro-cache"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ]
  }
}
