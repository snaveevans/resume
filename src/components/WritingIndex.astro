---
import { displayDate, postUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; topic?: string; allTopics: string[] }
const { posts, topic, allTopics } = Astro.props;
const latest = topic ? undefined : posts[0];
const rest = topic ? posts : posts.slice(1);
const years = [...new Set(rest.map(post => post.data.date.getUTCFullYear()))];
---
<div class="writing-header g12"><h1>Writing</h1></div>
{posts.length === 0 && !topic ? <p class="writing-empty">Nothing is published yet.</p> : <>
  <nav class="topic-nav" aria-label="Filter by topic">
    <a href="/writing" aria-current={!topic ? 'page' : undefined}>all</a>
    {allTopics.map(name => <a href={`/writing/topic/${name}`} aria-current={topic === name ? 'page' : undefined}>{name}</a>)}
  </nav>
  {latest && <section aria-label="Latest" class="writing-latest g12"><div class="latest-label">Latest</div><div class="latest-content"><p class="post-meta">{displayDate(latest.data.date)} · {latest.data.format} · {latest.data.topic}</p><h2><a href={postUrl(latest)}>{latest.data.title}</a></h2>{latest.data.description && <p>{latest.data.description}</p>}</div></section>}
  {years.map(year => <section class="writing-year g12" aria-label={String(year)}><h2>{year}</h2><div>{rest.filter(post => post.data.date.getUTCFullYear() === year).map(post => <a class="writing-row" href={postUrl(post)}><span><strong>{post.data.title}</strong><small>{post.data.format} · {post.data.topic}</small></span><time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time></a>)}</div></section>)}
</>}
