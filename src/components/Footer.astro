---
import { links } from '../data/resume';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['site-footer', { 'footer-full': full }]}>
  <div class="container footer-inner">
    {full ? <span class="footer-title">Tyler Evans</span> : <span>© {year} Tyler Evans · Eagle Mountain, UT</span>}
    <nav class="footer-links" aria-label="Elsewhere">
      {full && <><a href={links.github}>GitHub</a><a href={links.linkedin}>LinkedIn</a></>}
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>
