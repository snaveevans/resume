---
const links = ['writing', 'work', 'about', 'plarea', 'contact'];
const pathname = Astro.url.pathname;
---
<div class="container"><header class:list={["site-header", { "home-header": pathname === "/" }]}>
  <a class="brand" href="/">Tyler Evans</a>
  <nav class="site-nav" aria-label="Primary">
    {links.map(link => <a href={`/${link}`} aria-current={pathname === `/${link}` || pathname.startsWith(`/${link}/`) ? 'page' : undefined}>/{link}</a>)}
  </nav>
</header></div>
